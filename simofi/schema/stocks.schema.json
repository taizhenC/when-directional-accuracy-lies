{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta", "stocks"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["created_on"],
      "properties": {
        "created_on": { "type": "string", "format": "date" },
        "updated_on": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    },
    "stocks": {
      "type": "object",
      "description": "Keyed by stock ticker e.g. ARKK.",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "gics", "memberships"],
        "properties": {
          "name": { "type": "string" },
          "gics": { "$ref": "#/definitions/ftp_source" },
          "memberships": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "gics": {
      "type": "object",
      "properties": {
        "sector": { "type": "string" },
        "industry_group": { "type": "string" },
        "industry": { "type": "string" },
        "sub_industry": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}